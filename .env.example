# Environment variables for NGO Proposal Drafting Bot on Vercel
# You can set either GOOGLE_API_KEY (or GEMINI_API_KEY) or OPENAI_API_KEY
# If none are set, the application automatically uses the built-in intelligent RAG engine with simulated LLM streaming so it works seamlessly out-of-the-box!

# Google Gemini API Key (Recommended for high-speed & large context RAG)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Vector Search Mode: faiss | semantic | in-memory
VECTOR_DB=in-memory
